<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.TextFlow?>

<AnchorPane prefHeight="640" prefWidth="960" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.TypingModeController">

    <!-- Background Image -->
    <ImageView fitHeight="640" fitWidth="960" styleClass="background-image">
        <image>
            <Image url="@Frames/bg_image.JPG" />
        </image>
    </ImageView>

    <!-- Wooden Frame -->
    <ImageView fitHeight="559.0" fitWidth="828.0" layoutX="67.0" layoutY="15.0">
        <image>
            <Image url="@Frames/setting_BG.png" />
        </image>
    </ImageView>

    <!-- Timer Label -->
    <Label fx:id="timerLabel" layoutX="414.0" layoutY="72.0" styleClass="title-label" text="Time: 60" />
    <!-- Small Note Label -->
    <Label layoutX="170.0" layoutY="286.0" prefHeight="26.0" prefWidth="526.0" style="-fx-font-size: 14px; -fx-text-fill: #4B2E1E; -fx-font-weight: bold;" text="Note:  for correct new line into a function 'int main() {/n' 4 space then 'int'." />

    <!-- Code Display -->
    <ScrollPane fx:id="codeScrollPane" fitToWidth="true" layoutX="170.0" layoutY="114.0" prefHeight="172.0" prefWidth="623.0" styleClass="wooden-code-area">
        <content>
            <TextFlow fx:id="codeFlow" styleClass="quiz-section">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10" />
                </padding>
            </TextFlow>
        </content>
    </ScrollPane>


    <!-- Typing TextArea -->
    <TextArea fx:id="typingArea" layoutX="169.0" layoutY="312.0" prefHeight="158.0" prefWidth="623.0" promptText="Start typing here..." style="-fx-font-size: 16px; -fx-font-family: 'Consolas';" wrapText="true" />

    <!-- Try Again Button -->
    <Button fx:id="tryAgainButton" layoutX="407.0" layoutY="492.0" onAction="#handleTryAgain" prefHeight="40.0" prefWidth="150.0" styleClass="wooden-button" text="Try Again" />

    <!-- Music Icon (Optional) -->
    <ImageView fx:id="musicIcon" fitHeight="50" fitWidth="50" layoutX="36.0" layoutY="576.0" onMouseClicked="#toggleMusic" pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="@Frames/music_on.png" />
        </image>
    </ImageView>
    <!-- Home Icon -->
    <ImageView fx:id="homeIcon" fitHeight="55.0" fitWidth="55.0" layoutX="859.0" layoutY="559.0" onMouseClicked="#goBackToHome" pickOnBounds="true" preserveRatio="true" styleClass="home-icon">
        <image>
            <Image url="@Frames/Back_Home.png" />
        </image>
    </ImageView>

</AnchorPane>
